# 1. Maven-specific files and directories
# -----------------------------------------------
# The 'target' directory contains all build artifacts (compiled classes, JARs, etc.)
target/

# Maven log files
*.log
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties

# Maven wrapper files (if you don't want to enforce them for every developer)
# However, usually you want to commit these, so they are commented out.
# .mvn/
# mvnw
# mvnw.cmd


# 2. IDE-specific configuration files
# ------------------------------------------

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
atlassian-ide-plugin.xml

# Eclipse
.classpath
.project
.settings/
.metadata/
bin/
tmp/
*.tmp
*.bak
*.swp
*~.nib

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/


# 3. Operating system-specific files
# ---------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# Windows
# Desktop.ini
# thumbs.db


# 4. General and miscellaneous files
# ------------------------------------
# Log files
*.log
logs/

# Local configuration files
# (e.g., when storing passwords locally that shouldn't be in the repo)
local.properties
src/main/resources/db.properties

# Compressed files often created as backups
*.zip
*.tar
*.gz
*.rar

# hs_err_pid* files created by the JVM during a crash
hs_err_pid*.env
githpwd
db-data/
.env
compose.yml.backup
